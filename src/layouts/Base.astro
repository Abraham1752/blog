---
/**
 * Base.astro · 全局 HTML 外壳
 * head 首位为防闪烁(FOUC)内联脚本；包含 meta/OG/canonical/RSS autodiscovery/JSON-LD。
 */
import '../data/tokens-base.css';
import '../data/swiss-tokens.css';
import '../data/ink-tokens.css';
import '../data/fonts.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  skin: 'swiss' | 'ink';
  ogImage?: string;
  jsonLd?: object[];
  noindex?: boolean;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  skin,
  ogImage = `${import.meta.env.BASE_URL}og-fallback.png`,
  jsonLd = [],
  noindex = false,
  type = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site!);
const siteName = 'Yikino · AI 小玩具开发日志';

const ld = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        name: siteName,
        url: Astro.site?.origin,
        inLanguage: 'zh-CN',
      },
      {
        '@type': 'Person',
        name: 'Abraham1752',
        url: Astro.site?.origin,
        sameAs: ['https://github.com/Abraham1752'],
      },
    ],
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang="zh-CN" data-skin={skin}>
  <head>
    <script is:inline>
      (function () {
        var theme = 'light';
        try {
          var stored = localStorage.getItem('theme-preference');
          theme =
            stored === 'dark' || stored === 'light'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
        } catch (e) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <Font cssVariable="--fw-archivo-black" preload={skin === 'swiss'} />
    <Font cssVariable="--fw-space-grotesk" />
    <Font cssVariable="--fw-playfair-display" preload={skin === 'ink'} />
    <Font cssVariable="--fw-source-serif-4" />
    <Font cssVariable="--fw-jetbrains-mono" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Yikino RSS"
      href={`${Astro.site}${import.meta.env.BASE_URL}rss.xml`}
    />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="theme-color" content="#F5F3EE" />
    <meta name="color-scheme" content="light dark" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      /* 动效门卫：默认静态（可访问/SEO 安全），仅当 JS 可用且用户未要求减少动效时开启 */
      (function () {
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var root = document.documentElement;
          root.classList.add('anime-on');
        } catch (e) {
          /* 忽略 */
        }
      })();
    </script>
  </head>
  <body>
    <Header activePath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      /* 滚动揭示调度：IntersectionObserver，一次性触发（不重复回退） */
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        if (!('IntersectionObserver' in window) || !document.documentElement.classList.contains('anime-on')) {
          els.forEach(function (el) {
            el.classList.add('is-in');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  body {
    background-color: var(--bg);
    background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: 0 60px;
  }
  /* 阅读层（ink）不需要点阵，纯净纸感 */
  html[data-skin='ink'] body {
    background-image: none;
  }
  /* ---------- 滚动揭示：anime-on 时元素预置隐藏，进入视口后显示 ---------- */
  html.anime-on [data-reveal] {
    opacity: 0;
    transform: translateY(var(--reveal-offset));
    transition:
      opacity var(--dur-reveal) var(--ease-press) var(--reveal-delay, 0s),
      transform var(--dur-reveal) var(--ease-press) var(--reveal-delay, 0s);
  }
  html.anime-on [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }
  html.anime-on [data-reveal]:focus-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    html.anime-on [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    html.anime-on .page-title,
    html.anime-on .page-sub,
    html.anime-on .post-head {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
  /* ---------- 公共入场 keyframes（压印 / 色块弹出 / 淡入上移） ---------- */
  @keyframes press-in {
    to { transform: translateY(0); }
  }
  @keyframes block-pop {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  /* 页面标题 / 副标题统一入场（归档·项目·标签等瑞士页） */
  html.anime-on .page-title {
    animation: press-in var(--dur-press) var(--ease-press) backwards;
  }
  html.anime-on .page-sub {
    animation: fade-up var(--dur-reveal) var(--ease-press) 140ms backwards;
  }
  /* ink 文章页头：纸感淡入 */
  html.anime-on .post-head {
    animation: fade-up var(--dur-reveal) var(--ease-press) backwards;
  }
  /* 选区质感 */
  ::selection {
    background: var(--lemon);
    color: var(--lemon-fg);
  }
  html[data-skin='ink'] ::selection {
    background: var(--accent-text);
    color: var(--bg);
  }
</style>
