---
/**
 * blog/[slug].astro · 文章页（ink 皮肤）
 * 含相关文章（同分类优先，标签重合补充，最多 5 篇）
 */
import { getCollection, render } from 'astro:content';
import InkLayout from '../../layouts/InkLayout.astro';
import PrevNext from '../../components/PrevNext.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i - 1] ?? null, next: posts[i + 1] ?? null },
  }));
}

const { post, prev, next } = Astro.props as {
  post: Awaited<ReturnType<typeof getCollection<'posts'>>>[number];
  prev: (typeof post) | null;
  next: (typeof post) | null;
};

const B = import.meta.env.BASE_URL;

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 相关文章：同分类 2 分 / 标签重合 1 分，分数相同按时间新者优先，最多 5 篇
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    score:
      (p.data.category === post.data.category ? 2 : 0) +
      (p.data.tags.some((t) => post.data.tags.includes(t)) ? 1 : 0),
  }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 5)
  .map((x) => x.post);

const { Content } = await render(post);
---

<InkLayout post={post}>
  <Content />
  {related.length > 0 && (
    <section class="related" aria-label="相关文章" data-reveal>
      <h2 class="related__title">相关文章</h2>
      <ul class="related__list">
        {related.map((r) => (
          <li>
            <a href={`${B}blog/${r.id}/`}>
              <span class="related__name">{r.data.title}</span>
              <span class="related__meta">
                {r.data.category} ·{' '}
                {new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit' }).format(r.data.pubDate)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  <PrevNext
    prev={prev ? { slug: prev.id, title: prev.data.title } : undefined}
    next={next ? { slug: next.id, title: next.data.title } : undefined}
  />
</InkLayout>

<style>
  .ink-page {
    max-width: var(--max-prose);
    margin-inline: auto;
    padding: var(--space-6) var(--space-3) 0;
  }
  .post-head {
    margin-bottom: var(--space-6);
  }
  .post-head__meta {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }
  .post-head__cat {
    color: var(--accent-text);
    font-weight: 700;
  }
  .post-head__title {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: var(--lh-heading);
    margin-bottom: var(--space-3);
  }
  .post-head__desc {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--muted);
  }
  .post-head__en {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 15px;
    color: var(--muted);
    margin-top: var(--space-2);
  }
  .post-foot {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
  }
  .post-foot__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .post-foot__meta {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--ls-mono);
    color: var(--muted);
  }
  .related {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
  }
  .related__title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    margin-bottom: var(--space-3);
  }
  .related__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .related__list li + li {
    margin-top: var(--space-2);
  }
  .related__list a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    color: var(--fg);
  }
  .related__list a:hover .related__name {
    color: var(--accent-text);
  }
  .related__name {
    font-size: 15px;
    transition: color 0.15s ease;
  }
  .related__meta {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--ls-mono);
    color: var(--muted);
  }
</style>

<style is:global>
  /* ---------- Prose：68ch 正文排版（ink 皮肤） ---------- */
  .prose {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--fg);
  }
  .prose h2,
  .prose h3,
  .prose h4 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: var(--lh-heading);
    margin-top: var(--space-5);
    margin-bottom: var(--space-3);
  }
  .prose h2 {
    font-size: var(--fs-h2);
  }
  .prose h3 {
    font-size: var(--fs-h3);
  }
  .prose h4 {
    font-size: 19px;
  }
  .prose p {
    margin-bottom: var(--space-3);
  }
  .prose a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: text-decoration-thickness var(--dur-fast) var(--ease-out);
  }
  .prose a:hover {
    text-decoration-thickness: 2px;
  }
  .prose a:active {
    color: var(--accent-hover-bg);
  }
  .prose strong {
    font-weight: 700;
  }
  .prose ul,
  .prose ol {
    margin-bottom: var(--space-3);
    padding-left: 1.5em;
  }
  .prose li {
    margin-bottom: var(--space-1);
  }
  .prose li::marker {
    color: var(--accent-text);
  }
  .prose blockquote {
    border-left: 4px solid var(--quote-border);
    padding-left: var(--space-3);
    margin: var(--space-4) 0;
    color: var(--muted);
    font-style: italic;
  }
  .prose hr {
    border: 0;
    border-top: 1px solid var(--hairline);
    margin: var(--space-5) 0;
  }
  .prose pre {
    background: var(--block-bg);
    border: 1px solid var(--code-border);
    border-radius: var(--radius-code);
    padding: var(--space-3);
    overflow-x: auto;
    margin: var(--space-4) 0;
    font-size: 13.5px;
    line-height: 1.7;
  }
  .prose code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--block-bg);
    border-radius: 4px;
    padding: 0.15em 0.4em;
  }
  .prose pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .prose :not(pre) > code {
    background: var(--block-bg);
    color: var(--accent-text);
  }
  /* rehype-mermaid 输出：居中 + 边框 + 描述文字 */
  .prose picture,
  .prose img[data-mermaid] {
    display: block;
    margin: var(--space-4) auto;
    border: 1px solid var(--code-border);
    border-radius: var(--radius-code);
    padding: var(--space-2);
    background: var(--block-bg);
  }
  .prose img {
    border-radius: var(--radius-md);
    margin: var(--space-4) 0;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-4) 0;
    font-size: 0.95em;
  }
  .prose th,
  .prose td {
    border: 1px solid var(--hairline);
    padding: var(--space-2);
    text-align: left;
  }
  .prose th {
    background: var(--block-bg);
    font-weight: 700;
  }
  /* 暗色下 Shiki 双主题由 html[data-theme] 控制 */
</style>
